{
  "name": "llmbench",
  "private": true,
  "type": "module",
  "description": "Pulls LLM benchmark results from any listed leaderboard and shows them side by side.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "scrape": "node scripts/scrape.ts",
    "add-source": "node scripts/add-source.ts",
    "resolve": "node scripts/resolve.ts",
    "build": "node --disable-warning=ExperimentalWarning scripts/build.ts",
    "report-issues": "node scripts/report-issues.ts",
    "validate": "node scripts/validate.ts",
    "typecheck": "tsc",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/**/*.test.ts\"",
    "preview": "python3 -m http.server 4321 --directory site/dist"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "hyparquet": "1.33.0",
    "hyparquet-writer": "0.17.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
