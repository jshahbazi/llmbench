{
  "name": "llmbench",
  "private": true,
  "type": "module",
  "description": "Pulls LLM benchmark results from any listed leaderboard and shows them side by side.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "scrape": "node scripts/scrape.ts",
    "build": "node scripts/build-data.ts",
    "validate": "node scripts/validate.ts",
    "typecheck": "tsc",
    "test": "node --test \"tests/**/*.test.ts\"",
    "preview": "python3 -m http.server 4321 --directory site/dist"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
